# ──────────────────────────────────────────────
# JellySort — Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ──────────────────────────────────────────────

# ── Classification ────────────────────────────
# Confidence thresholds (0.0 - 1.0) for classification and path resolution.
MODEL_CLASSIFY_CONFIDENCE_THRESHOLD=0.65
MODEL_PATH_CONFIDENCE_THRESHOLD=0.6

# ── Download Client (qBittorrent via MCP) ─────
# Toggle: set to "true" to enable download client checks
ENABLE_DOWNLOAD_CLIENT_CHECK=true

# Download client type: "qbittorrent" (default)
DOWNLOAD_CLIENT=qbittorrent

# MCP endpoint for qBittorrent
QBT_MCP_URL=http://localhost:8093/mcp

# API key for qBittorrent MCP
QBT_MCP_API_KEY=

# Optional: qBittorrent WebUI credentials (used for some operations)
# QBT_WEBUI_USER=
# QBT_WEBUI_PASS=

# ── Jellyfin Integration (optional) ───────────
# Set to "true" to auto-scan Jellyfin libraries after moving files
ENABLE_JELLYFIN_INTEGRATION=true

# Jellyfin server URL
JELLYFIN_BASE_URL=http://localhost:8096

# Jellyfin API key (create one in Jellyfin Dashboard > API Keys)
JELLYFIN_API_KEY=

# Library names as configured in Jellyfin
JELLYFIN_MOVIE_LIBRARY_NAME=Movies
JELLYFIN_SERIES_LIBRARY_NAME=Shows

# ── Storage Paths ─────────────────────────────
# Comma-separated paths where torrent downloads reside
DOWNLOAD_ROOTS=/media/torrents

# Comma-separated paths where organised movies are stored.
# Each entry can optionally include a description after :: for the LLM report.
# Example: /media/movies::Standard movies,/media/movies_4k::4K/UHD movies
MOVIE_ROOTS=/media/movies

# Comma-separated paths where organised series are stored.
# Each entry can optionally include a description after :: for the LLM report.
# Example: /media/series::Primary shows folder,/media/series_alt::Secondary shows folder (mature/R-rated content)
SERIES_ROOTS=/media/series

# Series title aliases: maps release titles (often Japanese) to the library folder name.
# Format: "alias::canonical" entries separated by commas.
# Example: Yani Neko::Chainsmoker Cat Yani Neko
SERIES_TITLE_ALIASES=

# ── Web UI Panel Auth ────────────────────────
# Login password for the Web UI panel (served on the MCP port, 18328).
# Empty (default) = direct login, no password prompt.
# Set a value to require a password before the panel APIs respond.
UI_PANEL_PASSWORD=

# ── Logging ─────────────────────────────────
# LOG_FORMAT: "json" for structured JSON logs (good for prod), empty for plain text.
# LOG_LEVEL: INFO, DEBUG, WARNING, ERROR
# LOG_FORMAT=json
# LOG_LEVEL=INFO

# ── MCP Access Control ───────────────────────
# When true (default), unauthenticated MCP requests to port 18328 pass through.
# Set to false to require a valid API key (managed via the Web UI "API Keys"
# page) or MCP_DEFAULT_TOKEN on every /mcp request.
MCP_ALLOW_UNAUTHENTICATED=true

# Path to the JSON file holding hashed API keys for MCP access (bind-mounted,
# survives rebuilds; no restart needed when keys change).
MCP_KEYS_FILE=config/mcp_keys.json

# Optional master token accepted as a valid MCP key for the "admin" user.
# Useful when MCP_ALLOW_UNAUTHENTICATED=false and you need a single known key.
# MCP_DEFAULT_TOKEN=
